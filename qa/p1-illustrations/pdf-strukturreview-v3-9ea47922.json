      "pdf_header": "%PDF-1.7",
      "pages": 1,
      "xmp_present": true,
      "pdfua_identifier_present": false,
      "roles": {
        "/Document": 1,
        "/NonStruct": 28,
        "/Figure": 1,
        "/P": 13,
        "/H1": 1,
        "/BlockQuote": 1,
        "/H2": 4,
        "/L": 2,
        "/LI": 6,
        "/Lbl": 3,
        "/LBody": 6,
        "/H3": 3
      },
      "text_operator_count_page_stream": 2085,
      "text_operators_without_mcid_or_artifact_page_stream": 0,
