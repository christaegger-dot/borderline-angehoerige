      },
      "text_operator_count_page_stream": 2003,
      "text_operators_without_mcid_or_artifact_page_stream": 0,
      "text_operators_inside_artifact_page_stream": 0,
      "visible_glyphs_without_enclosing_mcid": 0,
      "visible_character_mcids_not_referenced_in_structure": [],
      "structure_reading_order": [
        {
          "alternative_text": "Psychiatrische Universitätsklinik Zürich",
          "role": "/Figure"
        },
        {
          "mcid": 0,
          "text": "",
          "role": "/Figure"
        },
        {
          "mcid": 1,
          "text": "PRAXISBLATT",
          "role": "/P"
        },
        {
          "mcid": 2,
          "text": "Radikale Akzeptanz",
          "role": "/H1"
        },
        {
          "mcid": 3,
          "text": "Eine freiwillige Übung: die gegenwärtige Realität anerkennen, ohne aufzugeben – und Handlungsspielraum für das Beeinflussbare finden.",
          "role": "/P"
        },
        {
          "mcid": 4,
          "text": "",
          "role": "/BlockQuote"
        },
        {
          "mcid": 5,
          "text": "Diese Übung ist ein Angebot: «So ist es gerade. Ich muss es nicht gut finden.» Das schreibt die Zukunft nicht fest. Sie machen nichts falsch, wenn Akzeptanz heute schwerfällt. Gefühle und Grenzen bleiben berechtigt; Sie dürfen handeln und Unterstützung suchen.",
          "role": "/P"
        },
        {
          "mcid": 6,
          "text": "Akzeptanz ist nicht",
          "role": "/H2"
        },
        {
          "mcid": 25,
          "text": "Aufgeben",
          "role": "/LBody"
        },
        {
          "mcid": 26,
          "text": "Gutheissen",
          "role": "/LBody"
        },
        {
          "mcid": 27,
          "text": "Passivität",
          "role": "/LBody"
        },
        {
          "mcid": 28,
          "text": "Resignation",
          "role": "/LBody"
        },
        {
          "mcid": 7,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 8,
          "text": "Akzeptanz kann heissen",
          "role": "/H2"
        },
        {
          "mcid": 29,
          "text": "Anerkennen, was im Moment tatsächlich ist",
          "role": "/LBody"
        },
        {
          "mcid": 30,
          "text": "Kraft für Handlungsspielraum bewahren",
          "role": "/LBody"
        },
        {
          "mcid": 31,
          "text": "Mehr Handlungsspielraum gewinnen",
          "role": "/LBody"
        },
        {
          "mcid": 32,
          "text": "Weniger gegen das Jetzt ankämpfen",
          "role": "/LBody"
        },
        {
          "mcid": 9,
          "text": "Vereinfachte Übung: vier mögliche Schritte",
          "role": "/H2"
        },
        {
          "mcid": 41,
          "text": "1",
          "role": "/Lbl"
        },
        {
          "mcid": 33,
          "text": "Benennen",
          "role": "/H3"
        },
        {
          "mcid": 34,
          "text": "Was ist im Moment tatsächlich so?",
          "role": "/P"
        },
        {
          "mcid": 42,
          "text": "2",
          "role": "/Lbl"
        },
        {
          "mcid": 35,
          "text": "Spüren",
          "role": "/H3"
        },
        {
          "mcid": 36,
          "text": "Was löst das in mir aus?",
          "role": "/P"
        },
        {
          "mcid": 43,
          "text": "3",
          "role": "/Lbl"
        },
        {
          "mcid": 37,
          "text": "Anerkennen",
          "role": "/H3"
        },
        {
          "mcid": 38,
          "text": "Kann ich mir sagen: «So ist es gerade. Ich muss es nicht gut finden»? Akzeptanz braucht manchmal viele Anläufe.",
          "role": "/P"
        },
        {
          "mcid": 44,
          "text": "4",
          "role": "/Lbl"
        },
        {
          "mcid": 39,
          "text": "Handlungsspielraum",
          "role": "/H3"
        },
        {
          "mcid": 40,
          "text": "Was kann ich entscheiden oder beeinflussen? Wobei brauche ich Unterstützung? Was liegt nicht allein bei mir?",
          "role": "/P"
        },
        {
          "mcid": 10,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 11,
          "text": "Beispiel ohne akute Gefährdung",
          "role": "/H2"
        },
        {
          "mcid": 12,
          "text": "Die andere Person möchte heute keine Hilfe annehmen. Das enttäuscht mich, und ich mache mir Sorgen. Ich kann ihre Entscheidung nicht allein verändern. Ich kann sagen, was ich anbieten kann, meine Grenze beachten und mir selbst Beratung holen.",
          "role": "/P"
        },
        {
          "mcid": 13,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 14,
          "text": "Schutz geht vor",
          "role": "/H2"
        },
        {
          "mcid": 15,
          "text": "Bei Gefahr geht Schutz vor Akzeptanzübung. Sie müssen schwierige Realität nicht gut finden, um sie anzuerkennen. Akzeptanz heisst nicht bleiben, schweigen oder Gewalt tolerieren.",
          "role": "/P"
        },
        {
          "mcid": 16,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 17,
          "text": "Ein nächster Schritt",
          "role": "/H2"
        },
        {
          "mcid": 18,
          "text": "Wenn Sie möchten, probieren Sie die vier Schritte zunächst an einer kleinen, sicheren Alltagssituation aus. Wählen Sie einen Satz, der Ihnen hilft.",
          "role": "/P"
        },
        {
          "mcid": 19,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 20,
          "text": "Fachstelle Angehörigenarbeit · Psychiatrische Universitätsklinik Zürich",
          "role": "/P"
        },
        {
          "mcid": 21,
          "text": "Dieses Blatt ersetzt keine persönliche Beratung oder Behandlung.",
          "role": "/P"
        },
        {
          "mcid": 22,
          "text": "Eigene didaktische Darstellung der Fachstelle Angehörigenarbeit in Anlehnung an Linehan, M. M. (2015), DBT Skills Training Manual.",
          "role": "/P"
        },
        {
          "mcid": 23,
