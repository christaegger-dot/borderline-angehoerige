    {
      "id": "radikale-akzeptanz",
      "source_commit": "9ea47922ab1f2dd6ae317d102b547a97f981af42",
      "source_sha256": "9c89e918e072bc8fa18941355b3040b4913fdd9ea4e035c4f41a23e7e34cc06d",
      "pdf_header": "%PDF-1.7",
      "pages": 1,
      "xmp_present": true,
      "pdfua_identifier_present": false,
      "roles": {
        "/Document": 1,
        "/NonStruct": 35,
        "/Figure": 1,
        "/P": 15,
        "/H1": 1,
        "/BlockQuote": 1,
        "/H2": 6,
