      "structure_reading_order": [
        {
          "alternative_text": "Psychiatrische Universitätsklinik Zürich",
          "role": "/Figure"
        },
        {
          "mcid": 0,
          "text": "",
          "role": "/Figure"
        },
        {
          "mcid": 1,
          "text": "PRAXISBLATT",
          "role": "/P"
        },
        {
          "mcid": 2,
          "text": "Beispiel-Dialog",
          "role": "/H1"
        },
        {
          "mcid": 3,
          "text": "Ein möglicher Gesprächsweg: wahrnehmen, vorsichtig spiegeln, begrenzen – und nur wenn es passt wieder einsteigen.",
          "role": "/P"
        },
        {
          "mcid": 4,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 5,
          "text": "Ausgangspunkt",
          "role": "/H2"
        },
        {
          "mcid": 6,
          "text": "«Du bist nie für mich da! Du denkst nur an dich!»",
          "role": "/P"
        },
        {
          "mcid": 8,
          "text": "Ein möglicher Ablauf",
          "role": "/H2"
        },
        {
          "mcid": 7,
          "text": "",
          "role": "/L"
        },
        {
          "mcid": 39,
          "text": "1",
          "role": "/Lbl"
        },
        {
          "mcid": 25,
          "text": "Verbinden",
          "role": "/H3"
        },
        {
          "mcid": 26,
          "text": "«Ich merke, dass unser Gespräch gerade sehr angespannt ist.»",
          "role": "/P"
        },
        {
          "mcid": 40,
          "text": "2",
          "role": "/Lbl"
        },
        {
          "mcid": 28,
          "text": "Vorsichtig spiegeln",
          "role": "/H3"
        },
        {
          "mcid": 29,
          "text": "«Das klingt gerade sehr belastend. Verstehe ich dich richtig?»",
          "role": "/P"
        },
        {
          "mcid": 41,
          "text": "3",
          "role": "/Lbl"
        },
        {
          "mcid": 31,
          "text": "Grenze",
          "role": "/H3"
        },
        {
          "mcid": 32,
          "text": "«Ich möchte dieses Gespräch so nicht weiterführen. Ich beende es jetzt.»",
          "role": "/P"
        },
        {
          "mcid": 42,
          "text": "4",
          "role": "/Lbl"
        },
        {
          "mcid": 34,
          "text": "Pause",
          "role": "/H3"
        },
        {
          "mcid": 35,
          "text": "«Ich brauche jetzt Abstand. Ob und wann wir weiterreden, kläre ich später.»",
          "role": "/P"
        },
        {
          "mcid": 43,
          "text": "5",
          "role": "/Lbl"
        },
        {
          "mcid": 37,
          "text": "Optionaler Wiedereinstieg",
          "role": "/H3"
        },
        {
          "mcid": 38,
          "text": "«Ich möchte wieder sprechen. Passt es für dich gerade?»",
          "role": "/P"
        },
        {
          "mcid": 9,
          "text": "",
          "role": "/P"
        },
        {
          "mcid": 10,
          "text": "Der Ablauf ist eine Auswahl möglicher Sätze, keine Pflichtfolge. Passen Sie die Sätze an, lassen Sie Schritte aus oder beenden Sie das Gespräch. Es gibt keine Rückkehrpflicht.",
          "role": "/P"
        },
        {
          "mcid": 11,
          "text": "",
          "role": "/BlockQuote"
        },
        {
          "mcid": 12,
          "text": "Kurz und ruhig kann unter Anspannung leichter verständlich sein. Keine Formulierung garantiert eine bestimmte Reaktion.",
          "role": "/P"
        },
        {
          "mcid": 13,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 14,
          "text": "Schutz und Akuthilfe vor Gesprächstechnik",
          "role": "/H2"
        },
        {
          "mcid": 15,
          "text": "Bei Bedrohung oder Gewalt: Beenden Sie den Dialog, schaffen Sie Abstand und bringen Sie sich in Sicherheit; im Notfall 117. Bei vermuteter unmittelbarer Selbstgefährdung: Holen Sie umgehend professionelle Hilfe; bei unmittelbarer Gefahr 144. Bleiben Sie nur bei der Person, soweit dies für Sie sicher möglich ist. Sie müssen das Risiko nicht allein beurteilen oder bewältigen.",
          "role": "/P"
        },
        {
          "mcid": 16,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 17,
          "text": "Ein nächster Schritt",
          "role": "/H2"
        },
        {
          "mcid": 18,
          "text": "Lesen Sie den Dialog laut und markieren Sie die Sätze, die zu Ihrer Sprache passen.",
          "role": "/P"
        },
        {
          "mcid": 19,
          "text": "",
          "role": "/Document"
        },
        {
          "mcid": 20,
          "text": "Fachstelle Angehörigenarbeit · Psychiatrische Universitätsklinik Zürich",
          "role": "/P"
        },
        {
          "mcid": 21,
          "text": "Dieses Blatt ersetzt keine persönliche Beratung oder Behandlung.",
          "role": "/P"
        },
        {
          "mcid": 22,
          "text": "Eigene didaktische Darstellung der Fachstelle Angehörigenarbeit in Anlehnung an Mason, P. T. & Kreger, R. (2014); Fruzzetti, A. E. (2006).",
          "role": "/P"
        },
        {
          "mcid": 23,
          "text": "Für Angehörige – Fachstelle Angehörigenarbeit, PUK Zürich – Ch. Egger | Entwurf – fachlich-redaktionelle Freigabe ausstehend | Stand: 04.10.2026.",
          "role": "/P"
        },
        {
          "mcid": 24,
          "text": "Seite 1 / 1",
          "role": "/P"
        }
      ]
    },
